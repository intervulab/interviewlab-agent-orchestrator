# Environment Variables for InterviewLab Agent Orchestrator
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# =============================================
# LLM Provider Configuration
# Choose "grok" (recommended) or "openai"
# =============================================
LLM_PROVIDER=grok

# =============================================
# Grok (xAI) API Configuration
# Get your key at: https://console.x.ai
# =============================================
GROK_API_KEY=xai-your-grok-api-key-here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2

# Note: You can also use XAI_API_KEY as an alias:
# XAI_API_KEY=xai-your-key-here

# =============================================
# OpenAI Configuration (Alternative / Fallback)
# =============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================
# Application Settings
# =============================================
APP_ENV=development
APP_PORT=8000
DEBUG=true

# =============================================
# CORS — Allowed origins
# =============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# =============================================
# Interview Behaviour
# =============================================
# How many times Devil's Advocate debates each question (1-3 recommended)
MAX_DEBATE_ROUNDS=2

# Max questions generated per interview round
MAX_QUESTIONS_PER_ROUND=5
