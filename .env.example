# Environment Variables for InterviewLab Agent Orchestrator
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# =============================================
# LLM Configuration
# =============================================
# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Which model to use. Cheaper option: gpt-4o-mini. Best quality: gpt-4o
OPENAI_MODEL=gpt-4o-mini

# =============================================
# Application Settings
# =============================================
APP_ENV=development
APP_PORT=8000
DEBUG=true

# =============================================
# CORS — Add your frontend URLs here
# =============================================
# Component 1 (Next.js) typically runs on 3000
# Component 2 (Canvas) may run on 3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================
# Interview Behaviour
# =============================================
# How many times Devil's Advocate debates each question (1-3 recommended)
MAX_DEBATE_ROUNDS=2

# Max questions generated per interview round
MAX_QUESTIONS_PER_ROUND=5
