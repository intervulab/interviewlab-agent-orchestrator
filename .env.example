# Environment Variables for InterviewLab Agent Orchestrator
# Copy this file to .env and fill in your Groq API key.
# NEVER commit .env to git!

# =============================================
# Groq API Configuration
# Get your free key at: https://console.groq.com/keys
# =============================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# =============================================
# Application Settings
# =============================================
APP_ENV=development
APP_PORT=8000
DEBUG=true

# =============================================
# CORS — Allowed origins
# =============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# =============================================
# Interview Behaviour
# =============================================
# How many times Devil's Advocate debates each question (1-3 recommended)
MAX_DEBATE_ROUNDS=2

# Max questions generated per interview round
MAX_QUESTIONS_PER_ROUND=5
